{
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1"
  },
  "permissions": {
    "allow": [
      "mcp__linear__*",
      "mcp__claude_ai_Linear__*",
      "mcp__ide__getDiagnostics",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__navigate_page",
      "Bash(tmux *)",
      "Bash(cat *)",
      "Bash(cp *)",
      "Bash(curl *)",
      "Bash(echo *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(tail *)",
      "Bash(touch *)",
      "Bash(tree *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(cd * && grep *)",
      "Bash(cd * && find *)",
      "Bash(cd * && cat *)",
      "Bash(cd * && ls *)",
      "Bash(cd * && rg *)",
      "Bash(cd * && wc *)",
      "Bash(cd * && head *)",
      "Bash(cd * && tail *)",
      "Bash(cd * && grep * | *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm test *)",
      "Bash(npm ls *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(tsc *)",
      "Bash(astro *)",
      "Bash(vite *)",
      "Bash(uv add *)",
      "Bash(python3 *)",
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(goimports *)",
      "Bash(golangci-lint *)",
      "Bash(staticcheck *)",
      "Bash(GOCACHE=* go *)",
      "Bash(make *)",
      "Bash(gh *)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git check-ignore *)",
      "Bash(git checkout *)",
      "Bash(git diff *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git log *)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git worktree *)",
      "Bash(git ls-remote *)",
      "Bash(git rev-parse *)",
      "Bash(git show-ref *)",
      "Bash(git symbolic-ref *)",
      "Bash(git -C *)",
      "Bash(git merge-base *)",
      "Bash(git rev-list *)",
      "Bash(git push *)",
      "Bash(git ls-tree *)",
      "Bash(git grep *)",
      "Bash(swift build *)",
      "Bash(swift package *)",
      "Bash(./scripts/build.sh *)",
      "Bash(~/.myai/dotclaude/skills/checkout-work/scripts/checkout-work.sh *)",
      "Bash(magick identify:*)",
      "Bash(magick:*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(rm -rf *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(python3 -m pip *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-literal-tilde.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": false,
    "playground@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "firecrawl@claude-plugins-official": false,
    "netlify-skills@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false
  },
  "sandbox": {
    "enabled": false
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true
}
